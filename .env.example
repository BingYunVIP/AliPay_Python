# Initial configuration instance: loopback only; never put a password here.
PUBLIC_BASE_URL=http://127.0.0.1:888
ALLOW_REGISTRATION=false
TEST_MAX_AMOUNT=3000.00
BYPAY_BIND_HOST=127.0.0.1
BYPAY_CALLBACK_HOSTS=
# Payment credentials are encrypted through the administrator console.
# DATABASE and BYPAY_LOG_FILE default to this checkout's data directory.
# Explicit proxy ranges are required when deploying behind a trusted proxy.
BYPAY_TRUSTED_PROXIES=
# Optional explicit HTTP(S) proxy for CoinGecko only. Empty means direct.
# Does not inherit ALL_PROXY and does not change payment/RPC routes.
BYPAY_MARKET_PROXY_URL=
