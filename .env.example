BYPAY_DOMAIN=pay.bingyun.vip
PUBLIC_BASE_URL=https://pay.bingyun.vip
ALIPAY_ENV=production
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/app/secrets/app-private.pem
ALIPAY_PUBLIC_KEY_FILE=/app/secrets/alipay-public.pem
BYPAY_ADMIN_EMAIL=
BYPAY_ADMIN_PASSWORD=
ALLOW_REGISTRATION=false
TEST_MAX_AMOUNT=10.00
DATABASE=/app/data/web.sqlite3
BYPAY_LOG_FILE=/app/data/logs/payment.jsonl
BYPAY_TRUST_PROXY=1
BYPAY_CALLBACK_HOSTS=test.bingyun.vip
