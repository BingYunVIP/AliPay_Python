[Unit]
Description=BingYun Pay independent merchant demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Pay_Callback_Demo
EnvironmentFile=/root/Pay_Callback_Demo/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/Pay_Callback_Demo/.venv/bin/gunicorn --bind 127.0.0.1:8100 --workers 2 --threads 2 --timeout 30 --umask 0077 --no-control-socket wsgi:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
